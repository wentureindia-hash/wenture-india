# ============================================================
# Wenturex India International — Environment Configuration Template
# ============================================================

# Firebase Client Configuration (Frontend Auth & Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wenture-india.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wenture-india
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK Configuration (Server-Only: Used for verified token validation & Admin Firestore)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# NEVER prefix with NEXT_PUBLIC_ or commit actual keys to version control.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wenture-india.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----\n"
# Optional alternative: Single-line JSON service account string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"wenture-india",...}'

# Supabase Storage Configuration (Target Storage Engine)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Server-only key (NEVER prefix with NEXT_PUBLIC_ or expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site URL Configuration
NEXT_PUBLIC_SITE_URL=https://wentureindia.com

# Admin Email Whitelist (Comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=wentureindia@gmail.com,info@wentureindia.com

# Optional Email / Contact Routing
# CONTACT_EMAIL_RECIPIENT=info@wentureindia.com
